{
  "name": "webapp",
  "version": "1.0.0",
  "description": "방문예약 관리 시스템 - Hono + Cloudflare Pages + D1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:d1": "wrangler pages dev dist --d1=webapp-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "chart.js": "^4.4.0",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "@hono/vite-cloudflare-pages": "^0.1.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wrangler": "^4.151.1"
  }
}
