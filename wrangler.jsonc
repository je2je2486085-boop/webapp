{
  "name": "webapp",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": ""
    }
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "webapp-production",
          "database_id": ""
        }
      ]
    },
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "webapp-production",
          "database_id": ""
        }
      ]
    }
  },
  "vars": {
    "SOLAPI_API_KEY": "",
    "SOLAPI_API_SECRET": "",
    "SOLAPI_SENDER_PHONE": "",
    "SOLAPI_ADMIN_PHONE": ""
  }
}
